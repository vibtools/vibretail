# Normally generated automatically by the web installer at /install.
POS_APP_ENV=production
POS_TIMEZONE=Asia/Dhaka
POS_DB_HOST=127.0.0.1
POS_DB_PORT=3306
POS_DB_NAME=cloudcorepos
POS_DB_USER=
POS_DB_PASS=
POS_SESSION_IDLE_SECONDS=7200
POS_TRUST_PROXY=false
POS_ALLOW_WEB_INSTALL=false
POS_BACKUP_RETENTION_DAYS=30
POS_LOG_DIR=/path/outside/webroot/cloud-core-pos-runtime/logs
POS_BACKUP_DIR=/path/outside/webroot/cloud-core-pos-runtime/backups
POS_SERVICE_CREDENTIAL_KEY=base64:REPLACE_WITH_32_BYTE_BASE64_KEY
